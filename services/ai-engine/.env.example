# MineSetu AI — Python AI Processing Engine Environment Example
# Copy this file to services/ai-engine/.env or set these in container environment.
# NEVER commit production keys or credentials!

# Service Information
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Supabase Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Model Provider (Grok / xAI)
GROK_API_KEY_PRIMARY=xai-primary-key-here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL_ID=grok-2-1212

# Worker Settings
WORKER_ENABLED=true
POLL_INTERVAL_SECONDS=3.0
JOB_LEASE_SECONDS=300
MAX_JOB_RETRIES=3
BATCH_SIZE=5
