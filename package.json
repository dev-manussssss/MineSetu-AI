{
  "name": "minesetu-master",
  "version": "1.0.0",
  "private": true,
  "description": "MDMS + Mindsetu AI — Prototype of an AI-enabled extension layer around MDMS workflows",
  "scripts": {
    "start": "./start.sh",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "tsc --project backend/tsconfig.json --noEmit && npm --prefix frontend run build",
    "typecheck:backend": "tsc --project backend/tsconfig.json --noEmit",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --import tsx --test tests/unit/*.test.mjs",
    "test:python": "services/ai-engine/.venv/bin/python3 services/ai-engine/tests/test_ai_engine.py && services/ai-engine/.venv/bin/python3 services/ai-engine/tests/test_connectors.py",
    "test:promptfoo": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=./.promptfoo PROMPTFOO_CACHE_DIR=./.promptfoo promptfoo eval --no-cache",
    "test:e2e": "playwright test",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview"
  },
  "keywords": [
    "mdms",
    "mindsetu",
    "mining",
    "rag",
    "document-intelligence",
    "topic-modeling"
  ],
  "author": "MineSetu Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@vercel/node": "^20.0.0",
    "promptfoo": "^0.124.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
