# MDMS + Mindsetu AI — Environment Configuration Example
# Copy this file to .env or .env.local. NEVER commit actual API keys or secrets!

# Client-Safe Supabase Configuration (VITE_ prefix exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Privileged Configuration (Server/Edge Functions only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Grok / xAI / LLM API Configuration (Server-Side Only — 3-Tier Failover Cascade)
GROK_API_KEY_PRIMARY=xai-primary-key-here
GROK_API_KEY_SECONDARY=xai-secondary-key-here
GROK_API_KEY_TERTIARY=xai-tertiary-key-here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL_ID=grok-2-1212

# Application Configuration
VITE_APP_ENV=development
VITE_APP_DEMO_MODE=true
