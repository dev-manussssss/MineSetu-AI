{
  "installCommand": "npm install && npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/v1/auth/:action", "destination": "/api/v1/auth/[action]" },
    { "source": "/api/v1/documents", "destination": "/api/v1/documents" },
    { "source": "/api/v1/manual-records", "destination": "/api/v1/manual-records" },
    { "source": "/api/v1/requests", "destination": "/api/v1/requests" },
    { "source": "/api/v1/reviews", "destination": "/api/v1/reviews" },
    { "source": "/api/v1/reports", "destination": "/api/v1/reports" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
